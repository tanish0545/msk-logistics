# ==============================================================================
# MSK Logistics Pvt. Ltd. — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your authorized production secrets.
# NEVER commit production passwords or API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_APP_NAME="MSK Logistics Pvt. Ltd."
VITE_SITE_URL="https://msklogisticsolution.vercel.app"
VITE_CONTACT_EMAIL="info@msklogisticsolution.com"
VITE_CONTACT_PHONE="+91 81086 72929"

# Optional Custom Enquiry API Endpoint Override (defaults to local /api/quote and /api/contact)
VITE_ENQUIRY_API_URL=""

# ------------------------------------------------------------------------------
# 2. Gmail SMTP Configuration (Nodemailer - Primary Serverless Email Dispatch)
# Generate Google App Password from: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@msklogisticsolution.com"
SMTP_PASS="your-16-character-google-app-password"

# Destination inbox for all customer inquiries and quote submissions
CONTACT_TO_EMAIL="info@msklogisticsolution.com"

# Branded sender display address
CONTACT_FROM_EMAIL="MSK Logistics Solution <info@msklogisticsolution.com>"

# ------------------------------------------------------------------------------
# 3. Resend API Configuration (Secondary Fallback Delivery Engine)
# Obtain from https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY="your-resend-api-key"

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Configuration (MSK ORBIT AI Chatbot)
# Obtain from https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
